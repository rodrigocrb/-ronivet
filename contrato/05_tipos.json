{
  "nome": "tipos de atendimento e campos configuráveis",
  "passos": [
    { "como": "sec@c.com", "metodo": "POST", "caminho": "/api/tipos",
      "corpo": { "nome": "Consulta" }, "espera": { "status": 403 } },
    { "como": "admin@c.com", "metodo": "POST", "caminho": "/api/tipos",
      "corpo": { "nome": "  " }, "espera": { "status": 422 } },
    { "como": "admin@c.com", "metodo": "POST", "caminho": "/api/tipos",
      "corpo": { "nome": "Consulta", "duracao_min": 45 },
      "espera": { "status": 201, "corpo": { "nome": "Consulta", "duracao_min": 45, "ativo": "SIM", "campos": { "$tamanho": 0 } } },
      "guardar": { "tipo": "id" } },
    { "como": "admin@c.com", "metodo": "POST", "caminho": "/api/tipos/{tipo}/campos",
      "corpo": { "nome": "peso", "rotulo": "Peso (kg)", "tipo_dado": "NUMERO", "obrigatorio": true },
      "espera": { "status": 201, "corpo": { "nome": "peso", "tipo_dado": "NUMERO", "obrigatorio": true, "ordem": 1, "opcoes": [] } },
      "guardar": { "campoPeso": "id" } },
    { "como": "admin@c.com", "metodo": "POST", "caminho": "/api/tipos/{tipo}/campos",
      "corpo": { "nome": "peso", "rotulo": "Outro peso" },
      "espera": { "status": 409, "corpo": { "detail": { "codigo": "campo_duplicado" } } } },
    { "como": "admin@c.com", "metodo": "POST", "caminho": "/api/tipos/{tipo}/campos",
      "corpo": { "nome": "tutor_extra", "rotulo": "Reservado" }, "espera": { "status": 422 } },
    { "como": "admin@c.com", "metodo": "POST", "caminho": "/api/tipos/{tipo}/campos",
      "corpo": { "nome": "Peso2", "rotulo": "Nome inválido" }, "espera": { "status": 422 } },
    { "como": "admin@c.com", "metodo": "POST", "caminho": "/api/tipos/{tipo}/campos",
      "corpo": { "nome": "pelagem", "rotulo": "Pelagem", "tipo_dado": "LISTA" },
      "espera": { "status": 422 } },
    { "como": "admin@c.com", "metodo": "POST", "caminho": "/api/tipos/{tipo}/campos",
      "corpo": { "nome": "retorno", "rotulo": "Retorno", "tipo_dado": "LISTA", "opcoes": ["Sim", "Não"] },
      "espera": { "status": 201, "corpo": { "ordem": 2, "opcoes": ["Sim", "Não"] } },
      "guardar": { "campoRetorno": "id" } },
    { "como": "admin@c.com", "metodo": "POST", "caminho": "/api/tipos/inexistente/campos",
      "corpo": { "nome": "x", "rotulo": "X" }, "espera": { "status": 404 } },
    { "como": "admin@c.com", "metodo": "PATCH", "caminho": "/api/campos/{campoPeso}",
      "corpo": { "rotulo": "Peso do animal (kg)", "obrigatorio": false },
      "espera": { "status": 200, "corpo": { "rotulo": "Peso do animal (kg)", "obrigatorio": false } } },
    { "como": "admin@c.com", "metodo": "PATCH", "caminho": "/api/campos/{campoRetorno}",
      "corpo": { "ativo": "NAO" }, "espera": { "status": 200, "corpo": { "ativo": "NAO" } } },
    { "como": "sec@c.com", "metodo": "GET", "caminho": "/api/tipos",
      "espera": { "status": 200, "corpo": { "$contem": { "id": "@tipo", "nome": "Consulta", "campos": { "$tamanho": 1 } } } } },
    { "como": "admin@c.com", "metodo": "PATCH", "caminho": "/api/tipos/{tipo}",
      "corpo": { "duracao_min": 0 }, "espera": { "status": 422 } },
    { "como": "admin@c.com", "metodo": "PATCH", "caminho": "/api/tipos/{tipo}",
      "corpo": { "nome": "Consulta geral", "duracao_min": 20 },
      "espera": { "status": 200, "corpo": { "nome": "Consulta geral", "duracao_min": 20 } } },
    { "como": "admin@c.com", "metodo": "PATCH", "caminho": "/api/tipos/{tipo}",
      "corpo": { "ativo": "NAO" }, "espera": { "status": 200, "corpo": { "ativo": "NAO" } } },
    { "como": "sec@c.com", "metodo": "GET", "caminho": "/api/tipos",
      "espera": { "status": 200, "corpo": { "$tamanho": 1 } } },
    { "como": "admin@c.com", "metodo": "GET", "caminho": "/api/tipos?incluir_inativos=true",
      "espera": { "status": 200, "corpo": { "$tamanho": 2 } } }
  ]
}
